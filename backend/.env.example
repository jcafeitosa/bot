# Binance testnet keys are optional for public market-data polling.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Jev/TypeSafe advisor. Optional; no account credentials are sent to the model.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# PostgreSQL: supply only after provisioning the dedicated trading_bot database.
# Keep the actual URL in the shell environment or an ignored local .env file.
DATABASE_URL=
