# =============================================================================
# backend/.env (gitignored) — source of truth for secrets & operational overrides.
# Committed TOML: bot.toml (monitor preset), system.toml (non-sensitive defaults).
# Provider API keys: PRIMARY in PostgreSQL provider_credentials (see SDD); env below = deprecated bootstrap/dev only.
# =============================================================================

# --- system / database (infra secrets) ---
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/trading_bot
BOT_AGENTS_ENABLED=false
BOT_AGENTS_DB=bot_agents
BOT_AGENTS_DB_USER=bot_agents
BOT_AGENTS_DB_PASSWORD=
BOT_AGENTS_DATABASE_URL=
BOT_NEO4J_USER=neo4j
BOT_NEO4J_PASSWORD=
BOT_NEO4J_URI=bolt://127.0.0.1:7688
BOT_NEO4J_DATABASE=neo4j
# Neo4j projection (F1 agents + F2 bots + F3 orders): BOT_AGENTS_ENABLED=true with graph service up
# Outbox drain worker (F2.1.2): default from system.toml graph_projection_outbox_drain_secs=30; 0 disables
# BOT_GRAPH_PROJECTION_OUTBOX_DRAIN_SECS=
# BOT_GRAPH_PROJECTION_OUTBOX_DRAIN_BATCH=

# --- providers: endpoints (env overrides system.toml) ---
TYPESAFE_ENDPOINT=http://localhost:20128/v1/systemone
OPENAI_BASE_URL=
NINE_ROUTER_BASE_URL=
NVIDIA_NIM_BASE_URL=

# --- providers: API keys (DEPRECATED bootstrap — insert into provider_credentials instead) ---
# INSERT INTO provider_credentials (provider_id, key_name, secret) VALUES ('typesafe','api_key','...');
TYPESAFE_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
NGC_API_KEY=

# --- exchanges (Binance — remain .env; not provider_credentials) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# --- monitor ---
# PERSIST_MARKET_DATA=1

# --- agents ---
# BOT_AGENCY=acme
# Product owner bootstrap G1 (fail-closed): both required to insert singleton row on HTTP boot when DATABASE_URL connects.
# Without ACK, bootstrap env is ignored; with PG row present, register/promote must match bootstrapped owner_id (see agents-owner-bootstrap-g1-sdd.md).
# BOT_PRODUCT_OWNER_BOOTSTRAP_ID=
# BOT_PRODUCT_OWNER_BOOTSTRAP_ACK=

# --- bots ---
BOT_RUNTIME_ENABLED=false

# --- orders (HTTP submit + reconciliação; ver docs/reference/cli-and-config.md) ---
# BOT_ORDERS_EXECUTION=paper|dev_accept|live_exchange|disabled
# BOT_ORDERS_EXCHANGE_SUBMIT=recording|testnet (com BINANCE_TESTNET_*)
# BOT_PAPER_FILL_UNIT_PRICE=50000
# BOT_ORDERS_RECONCILIATION_POLL_SECS=60   # ≥60 com submit live wired; job no serve
# client_order_id no body do POST /api/v1/orders/submit (idempotência memória + PG)

# --- http admin (seam fail-closed; não substitui auth owner produto) ---
# docs/sdd/http-admin-auth-seam-sdd.md
BOT_HTTP_ADMIN_TOKEN=
BOT_HTTP_OWNER_ID=
BOT_HTTP_AGENCY_ID=
