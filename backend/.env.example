# Binance testnet keys are optional for public market-data polling.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Jev/TypeSafe advisor. Optional; no account credentials are sent to the model.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=http://localhost:20128/v1/systemone

# OpenAI-compatible proxies (optional; used when TYPESAFE_API_KEY is unset).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# NVIDIA NIM integrate API (optional; core::providers::nvidia_nim).
NVIDIA_API_KEY=
NGC_API_KEY=
NVIDIA_NIM_BASE_URL=

# PostgreSQL 18+ (TimescaleDB + pgvector). Database name must be trading_bot.
# See docs/operations/postgres-and-graph-dev.md and docker-compose.bot.yml.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/trading_bot

# Bot agent data services; keep these separate from DATABASE_URL.
BOT_AGENTS_ENABLED=false
BOT_AGENTS_DB=bot_agents
BOT_AGENTS_DB_USER=bot_agents
# Generate non-empty local-only passwords before using docker-compose.bot.yml.
# Example: openssl rand -hex 32. Values belong in ignored backend/.env only.
BOT_AGENTS_DB_PASSWORD=
# Construct the URL with the same password as BOT_AGENTS_DB_PASSWORD.
BOT_AGENTS_DATABASE_URL=
BOT_NEO4J_USER=neo4j
BOT_NEO4J_PASSWORD=
BOT_NEO4J_URI=bolt://127.0.0.1:7688
# pgvector is enabled by core/database migration 0000 when using the Timescale HA image.
# Neo4j Community exposes only its default database; graph scopes are app-enforced.
BOT_NEO4J_DATABASE=neo4j

# Optional: when set, mutating HTTP routes require Authorization: Bearer <token>.
BOT_HTTP_ADMIN_TOKEN=
# When admin token is set, optional binding for POST /api/v1/agents owner_id.
BOT_HTTP_OWNER_ID=
# When set, agent routes must use this agency query/body value.
# Also gates POST /api/v1/bots/runtime/promote: promoted_by must be an active agent in this agency with promote_runtime_bot.
BOT_HTTP_AGENCY_ID=
# GET /api/v1/meta exposes read-only http_seams (bindings as booleans, order/bot runtime flags).
# Order execution seam for HTTP API only. Default (unset/disabled): fail-closed 503 after risk.
# dev_accept: local double after risk. paper: in-process PaperLedgerExecutor after risk.
# live_exchange: requires BOT_ORDERS_EXCHANGE_SUBMIT=recording|testnet (see below); otherwise 503 live_exchange_not_wired.
# Optional client_order_id on POST /api/v1/orders/submit enables in-memory replay dedupe; with DATABASE_URL, also persists to order_idempotency_keys.
BOT_ORDERS_EXECUTION=
# In-process bot runtime promotion seam (HTTP only). Default false: promote/demote return 503.
BOT_RUNTIME_ENABLED=false

# With BOT_ORDERS_EXECUTION=live_exchange: recording (no network) or testnet (requires BINANCE_TESTNET_* above).
# BOT_ORDERS_EXCHANGE_SUBMIT=recording
# BOT_ORDERS_EXCHANGE_SUBMIT=testnet
# Optional paper ledger price for portfolio positions (HTTP paper mode).
# BOT_PAPER_FILL_UNIT_PRICE=50000
# Background reconciliation poll when live_exchange is wired (seconds; empty/0 = off).
# BOT_ORDERS_RECONCILIATION_POLL_SECS=60
