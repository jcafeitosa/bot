# Binance testnet keys are optional for public market-data polling.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Jev/TypeSafe advisor. Optional; no account credentials are sent to the model.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=http://localhost:20128/v1/systemone

# PostgreSQL for market data: only set after dedicated DB provisioning.
DATABASE_URL=

# Bot agent data services; keep these separate from DATABASE_URL.
BOT_AGENTS_ENABLED=false
BOT_AGENTS_DB=bot_agents
BOT_AGENTS_DB_USER=bot_agents
# Generate non-empty local-only passwords before using docker-compose.bot.yml.
# Example: openssl rand -hex 32. Values belong in ignored backend/.env only.
BOT_AGENTS_DB_PASSWORD=
# Construct the URL with the same password as BOT_AGENTS_DB_PASSWORD.
BOT_AGENTS_DATABASE_URL=
BOT_NEO4J_USER=neo4j
BOT_NEO4J_PASSWORD=
BOT_NEO4J_URI=bolt://127.0.0.1:7688
# Image contains pgvector, but the vector extension is not enabled by default.
# Enable only through a reviewed agent migration after embeddings/privacy gates.
# Neo4j Community exposes only its default database; graph scopes are app-enforced.
BOT_NEO4J_DATABASE=neo4j
